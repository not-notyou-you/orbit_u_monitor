# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
#
# cp .env.example .env

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DB_HOST=localhost
# 5432 = PostgreSQL yang terpasang langsung di host (isolasi dari The DataLab
# dilakukan lewat nama database). Pakai 5433 kalau memakai docker-compose.yml,
# yang sengaja memetakan DB-nya ke 5433 agar tidak bentrok dengan DataLab.
DB_PORT=5432
DB_NAME=orbit_u_monitor
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false   # set true to log all SQL queries (dev only)

# URL lengkap. Dipakai etl/reference_layers.py, tests/conftest.py (untuk
# menurunkan TEST_DATABASE_URL) dan beberapa tes integrasi. Harus konsisten
# dengan DB_* di atas.
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/orbit_u_monitor

# Test database. Optional: kalau dikosongkan, tests/conftest.py menurunkannya
# dari DATABASE_URL dengan menambah akhiran '_test' pada nama database.
# WAJIB database terpisah — test menjalankan drop_all() saat teardown.
# Buat dulu: psql -U postgres -c "CREATE DATABASE orbit_u_monitor_test"
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/orbit_u_monitor_test

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
# 8001 agar bisa jalan berbarengan dengan API The DataLab di 8000.
API_PORT=8001
API_DEBUG=false

# ---------------------------------------------------------------------------
# PIPELINE PATHS
# ---------------------------------------------------------------------------
OUTPUT_DIR=processed
LOGS_DIR=logs_pipeline
CHECKPOINT_DIR=checkpoints_pipeline
ANALYTICS_DIR=analytics

# ---------------------------------------------------------------------------
# OPTIONAL: Cloud storage (for S3/GCS product upload)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET_NAME=

# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
