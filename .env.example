# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
#
# cp .env.example .env

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DB_HOST=localhost
# PostgreSQL 14+ / PostGIS 3+ yang terpasang langsung di host. Isolasi dari
# The DataLab dilakukan lewat nama database (themonitor).
DB_PORT=5432
DB_NAME=themonitor
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false   # set true to log all SQL queries (dev only)

# URL lengkap. Dipakai tests/conftest.py (untuk menurunkan TEST_DATABASE_URL)
# dan beberapa tes integrasi. Harus konsisten dengan DB_* di atas.
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/themonitor

# Role login aplikasi (DATABASE.md §8.1). Dibuat oleh monitor_security.sql;
# database/apply_schema.py mengisi sandinya dari dua nilai ini. FastAPI
# terkoneksi sebagai monitor_app (NOINHERIT + SET LOCAL ROLE per request),
# scheduler/pipeline sebagai monitor_etl. DB_USER di atas (pemilik skema)
# hanya dipakai skrip setup, tidak pernah oleh aplikasi.
MONITOR_APP_PASSWORD=change_me_app
MONITOR_ETL_PASSWORD=change_me_etl

# Test database. Optional: kalau dikosongkan, tests/conftest.py menurunkannya
# dari DATABASE_URL dengan menambah akhiran '_test' pada nama database.
# WAJIB database terpisah — test menjalankan drop_all() saat teardown.
# Buat dulu: psql -U postgres -c "CREATE DATABASE themonitor_test"
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/themonitor_test

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
# 8001 agar bisa jalan berbarengan dengan API The DataLab di 8000.
API_PORT=8001
API_DEBUG=false

# Kunci HMAC JWT sesi (HS256, min. 32 karakter; API menolak start tanpanya).
# Buat: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Cookie sesi ber-flag Secure. Biarkan true (browser menerima Secure di
# http://localhost); false hanya untuk uji lewat http non-localhost.
COOKIE_SECURE=true
# Scheduler terjadwal (hidromet 02:00, Live, laporan; PIPELINE §7). Set false
# pada worker API tambahan; advisory lock PostgreSQL tetap mencegah job ganda.
ENABLE_SCHEDULER=true

# ---------------------------------------------------------------------------
# NASA EARTHDATA (GPM IMERG via GES DISC, MODIS via LANCE/LAADS)
# ---------------------------------------------------------------------------
# Token aplikasi dari urs.earthdata.nasa.gov -> Generate Token. Dibutuhkan job
# hidromet dan scripts/backfill_hydromet.py.
NASA_EARTHDATA_TOKEN=
# Folder laporan periodik (default data/reports).
# REPORTS_DIR=data/reports

# ---------------------------------------------------------------------------
# PIPELINE PATHS
# ---------------------------------------------------------------------------
OUTPUT_DIR=processed
LOGS_DIR=logs_pipeline
CHECKPOINT_DIR=checkpoints_pipeline
ANALYTICS_DIR=analytics

# ---------------------------------------------------------------------------
# OPTIONAL: Cloud storage (for S3/GCS product upload)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET_NAME=

# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
